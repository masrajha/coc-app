Options -Indexes
RewriteEngine On

# Keep source, dependency manifests, environment files and stored data private.
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|server\.js)$">
    Require all denied
</FilesMatch>
RewriteRule ^(src|vendor|data|test|tests|scripts)(/|$) - [F,L,NC]

# HTML app pages need PHP-generated Open Graph metadata, even if a root copy exists.
RewriteRule ^(?:index|clan|player|compare|compare-clan)\.html$ index.php [L,QSA]

# SEO documents are generated from current saved data, not stale root copies.
RewriteRule ^(?:robots\.txt|sitemap\.xml|sitemaps/[^/]+\.xml|guides(?:/[^/]+)?|explore/(?:clans|players)|leaderboards)$ index.php [L,QSA]

# Don't rewrite the front controller, real files, or directories. This is
# important on LiteSpeed/cPanel, where rewriting an existing index.php back to
# itself can trigger HTTP 508 (Loop Detected). Use the widely supported L flag.
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route app pages and /api/* URLs through the PHP front controller.
RewriteRule ^ index.php [L,QSA]
