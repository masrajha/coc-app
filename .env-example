# Salin menjadi .env hanya di server atau isi melalui Environment Variables cPanel.
# Buat API key untuk IP keluar (outbound) server hosting di developer.clashofclans.com.
COC_API_TOKEN=isi_token_api_anda
NODE_ENV=production
# Gunakan path absolut yang dapat ditulis dan berada di luar public_html.
# DATA_DIR=/home/USERNAME/coc-data
